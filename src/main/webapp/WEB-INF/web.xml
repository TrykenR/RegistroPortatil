<?xml version="1.0" encoding="UTF-8"?>
<!--
  Los servlets y el filtro se registran con anotaciones (@WebServlet,
  @WebFilter), así que aquí no hay mapeos. Este archivo existe por dos
  cosas que sí hacen falta para que la PWA funcione:

  1. El MIME type del manifest. Si el servidor lo entrega como
     text/plain, el navegador no lo reconoce y la app no es instalable.
  2. La página de bienvenida.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Autogestion de Portatiles Uniguajira</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <mime-mapping>
        <extension>webmanifest</extension>
        <mime-type>application/manifest+json</mime-type>
    </mime-mapping>

    <mime-mapping>
        <extension>json</extension>
        <mime-type>application/json</mime-type>
    </mime-mapping>

</web-app>
